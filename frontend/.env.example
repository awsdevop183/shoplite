# Where the BROWSER sends API calls. Baked in at BUILD time (npm run build).
#
# Default (recommended): leave it EMPTY. The browser calls /api/... on the same
# Nginx server, and Nginx forwards it to the backend's PRIVATE IP
# (see nginx/shoplite.conf). The backend then doesn't need a public IP.
VITE_API_URL=
#
# Alternative: call the backend directly on its PUBLIC IP (needs port 5000 open
# to the internet). Never use the private 172.31.x.x IP here: your browser runs
# outside AWS and can't reach it.
# VITE_API_URL=http://BACKEND_PUBLIC_IP:5000
